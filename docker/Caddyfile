{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip
	root * /app/dist

	# Menu data written by menu_converter.py into the volume.
	handle_path /data/* {
		@menu path /menu.json /menu_en.json /menu_tr.json /menu_static.json
		handle @menu {
			root * /app/src/locales
			header Cache-Control "no-cache"
			file_server
		}
		respond 404
	}

	# Hashed build output never changes.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		@pictures path /menu_pics/* *.jpg *.png *.svg *.webp
		header @pictures Cache-Control "public, max-age=86400"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
